# Kavenegar API key — required.
KAVENEGAR_API_KEY=your-api-key-here

# Phone number used by `sms-sender send --approval-test` — sent one test SMS,
# then prompts y/N at the terminal before fanning out. Optional; the
# --test-number flag overrides this. Use your own mobile, e.g. 0912xxxxxxx.
SMS_SENDER_TEST_NUMBER=

# Shlink API key — needed only for short links (`send --link-url …`, `clicks`).
# Never commit the real one; production gets its own least-privilege key.
SHLINK_API_KEY=

# Where Shlink lives; links look like <this>/<short-code>. Default shown.
# SHLINK_BASE_URL=https://kifpool.me/u

# Domains links may lead to (comma-separated; subdomains included). Default shown.
# SMS_SENDER_LINK_DOMAINS=kifpool.me

# --- Dashboard (Phase 3) ---
# Required: a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Host names / IPs people use to reach it, e.g. this machine's NetBird IP.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# With a NetBird IP or name, the full origin, e.g. http://100.x.y.z:8000
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Docker Compose publishes the port here. Set this machine's NetBird IP to
# share it with colleagues; never 0.0.0.0 on an untrusted network.
# BIND_ADDR=127.0.0.1
# Behind TLS (a proxy in front of gunicorn): send cookies over HTTPS only.
# DJANGO_SECURE_COOKIES=1
# Only if that proxy sets X-Forwarded-Proto and drops any value a client sent.
# DJANGO_TRUST_PROXY_SSL=1
# Sandbox: Kavenegar and Shlink simulated, nothing sent; data in data/sandbox/.
# SMS_SENDER_SANDBOX=1
# Where `python manage.py backup` and the worker's daily backup write.
# Default: <data>/backups.
# SMS_SENDER_BACKUP_DIR=
# Restricted sending: SMS go only to these numbers (comma-separated), from the
# dashboard and the CLI alike, e.g. your own phone while trying it out.
# SMS_SENDER_ALLOWED_NUMBERS=
