# What the server image installs (Dockerfile), locked with hashes in
# server.lock: pyproject.toml's dependencies and its `web` extra, without what
# only the tests need (pytest-django). tests/test_packaging.py keeps the two
# lists in step. To update: change pyproject.toml and this file, then
#   uv pip compile requirements/server.in --python-version 3.13 \
#     --python-platform linux --generate-hashes -o requirements/server.lock
# and run the suites and a sandbox rehearsal on the new image.
