msgid "{n} recipients were mid-send when the last run stopped: they're marked unknown and not sent again."
msgstr "{n} گیرنده هنگام توقف اجرای قبلی در میانه ارسال بود: وضعیتشان نامعلوم ثبت شد و دوباره ارسال نمی‌شود."

msgid "{n} recipients weren't sent (for example, Kavenegar was busy). You can send to them again."
msgstr "برای {n} گیرنده پیامکی ارسال نشد (برای نمونه، کاوه‌نگار مشغول بود). می‌توانید دوباره برایشان ارسال کنید."

msgid "{n} recipients' outcome is unknown: they're checked with Kavenegar at the next run, or you can check now."
msgstr "وضعیت {n} گیرنده نامعلوم است: در اجرای بعدی با کاوه‌نگار تطبیق داده می‌شود، یا همین حالا می‌توانید آن را بررسی کنید."

msgid "Needs attention"
msgstr "نیازمند توجه"

msgid "Stage"
msgstr "مرحله"

